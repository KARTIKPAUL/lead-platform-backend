PORT=4000
NODE_ENV=development

# MongoDB connection string (Atlas free tier or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lead-platform

# Long random string in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Comma-free single origin, or * for dev
CORS_ORIGIN=http://localhost:3000

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin12345!
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=Member12345!
